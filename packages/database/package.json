{
  "name": "@flexion/forms-database",
  "version": "0.2.0",
  "description": "10x Forms Platform database",
  "type": "module",
  "license": "CC0",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./context": {
      "development": {
        "types": "./src/context/index.ts",
        "import": "./src/context/index.ts"
      },
      "types": "./dist/types/context/index.d.ts",
      "import": "./dist/esm/context.js",
      "require": "./dist/cjs/context.js"
    },
    "./testing": {
      "development": {
        "types": "./src/testing.ts",
        "import": "./src/testing.ts"
      },
      "types": "./dist/types/testing.d.ts",
      "import": "./dist/esm/testing.js",
      "require": "./dist/cjs/testing.js"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "clean": "rimraf dist tsconfig.tsbuildinfo coverage",
    "dev": "rollup -c -w",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@flexion/forms-common": "workspace:*",
    "@types/pg": "^8.11.6",
    "better-sqlite3": "^11.7.2",
    "knex": "^3.1.0",
    "kysely": "^0.27.4",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.2",
    "@types/better-sqlite3": "^7.6.11",
    "testcontainers": "^10.13.2",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
